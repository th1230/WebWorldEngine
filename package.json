{
  "name": "webworld-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @ww/benchmark-app dev",
    "example": "pnpm --filter @ww/example-app dev",
    "build": "pnpm --filter @ww/benchmark-app build",
    "build:pkg": "pnpm --filter @webworld/format build && pnpm --filter @webworld/three build && pnpm --filter @webworld/cook build",
    "preview": "pnpm --filter @ww/benchmark-app preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "package-check": "node tools/package-check/verify.mjs",
    "site-check": "node tools/site-check/verify.mjs",
    "visual-check": "node tools/visual-check/verify.mjs",
    "verify:all": "pnpm verify && pnpm build:example && pnpm package-check && pnpm site-check && pnpm visual-check && pnpm physics-check && pnpm gi-check && pnpm ssgi-check && pnpm impostor-check && pnpm gpu-check && pnpm webgpu-check && pnpm vt-check && pnpm daynight-check && pnpm contact-check && pnpm df-shadow-check && pnpm reflect-check && pnpm sky-check && pnpm lod-fade-check && pnpm fog-check && pnpm vsm-check && pnpm shadow-lod-check && pnpm reflprobe-check && pnpm water-look-check && pnpm cross-check",
    "bench": "tsx tools/benchmark-runner/src/cli.ts run --profile hardware",
    "bench:smoke": "tsx tools/benchmark-runner/src/cli.ts run --profile smoke",
    "bench:baseline": "tsx tools/benchmark-runner/src/cli.ts baseline",
    "bench:compare": "tsx tools/benchmark-runner/src/cli.ts compare",
    "bench:variance": "tsx tools/benchmark-runner/src/cli.ts variance",
    "cook": "tsx packages/cook/src/cli.ts assets/source --builtins --out apps/benchmark/public/cooked",
    "cook:real": "tsx packages/cook/src/cli.ts assets/source/props --out apps/benchmark/public/cooked-real",
    "cook:sponza": "tsx packages/cook/src/cli.ts assets/source/sponza --out apps/benchmark/public/cooked-sponza",
    "bench:capacity": "tsx tools/benchmark-runner/src/cli.ts run --scene ab-ww-real --repeat 1",
    "gpu-check": "node tools/gpu-check/verify.mjs",
    "webgpu-check": "node tools/gpu-check/webgpu-vat.mjs",
    "physics-check": "node tools/physics-check/verify.mjs",
    "gi-check": "node tools/gi-check/verify.mjs",
    "occlusion-probe": "node tools/gpu-check/occlusion-saving.mjs",
    "occlusion-net": "node tools/gpu-check/occlusion-net.mjs",
    "split-value": "node tools/gpu-check/split-value.mjs",
    "impostor-ceiling": "node tools/gpu-check/impostor-ceiling.mjs",
    "probe-cost": "node tools/gpu-check/probe-cost.mjs",
    "texture-pressure": "node tools/gpu-check/texture-pressure.mjs",
    "contact-scale": "node tools/gpu-check/contact-scale.mjs",
    "ssgi-check": "node tools/gpu-check/ssgi.mjs 40",
    "impostor-check": "node tools/gpu-check/impostor.mjs",
    "frame-bound": "node tools/gpu-check/frame-bound.mjs",
    "stream-hitch": "node tools/gpu-check/stream-hitch.mjs",
    "vt-check": "node tools/gpu-check/virtual-texture.mjs",
    "stream-trace": "node tools/gpu-check/stream-trace.mjs",
    "daynight-check": "node tools/gpu-check/daynight.mjs",
    "contact-check": "node tools/gpu-check/contact-shadows.mjs",
    "df-shadow-check": "node tools/gpu-check/df-shadows.mjs",
    "reflect-check": "node tools/gpu-check/reflections.mjs",
    "sky-check": "node tools/gpu-check/sky.mjs",
    "lod-fade-check": "node tools/gpu-check/lod-fade.mjs",
    "fog-check": "node tools/gpu-check/fog.mjs",
    "vsm-check": "node tools/gpu-check/vsm.mjs",
    "shadow-lod-check": "node tools/gpu-check/shadow-lod.mjs",
    "reflprobe-check": "node tools/gpu-check/reflection-probes.mjs",
    "build:example": "pnpm --filter @ww/example-app build",
    "water-look-check": "node tools/gpu-check/water-look.mjs",
    "cross-check": "node tools/gpu-check/cross-backend.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@webgpu/types": "^0.1.71",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
