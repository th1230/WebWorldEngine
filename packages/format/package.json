{
  "name": "@webworld/format",
  "version": "0.1.0",
  "description": "@webworld/three 與 @webworld/cook 之間的資產格式契約：型別、常數，以及「誤差」這個數字的定義。",
  "keywords": [
    "three",
    "lod",
    "asset-format",
    "geometric-error",
    "virtual-texture",
    "distance-field"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasYeh/WebWorldEngine.git",
    "directory": "packages/format"
  },
  "bugs": "https://github.com/thomasYeh/WebWorldEngine/issues",
  "homepage": "https://github.com/thomasYeh/WebWorldEngine/tree/main/packages/format#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node tools/flatten-types.mjs",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "vite-plugin-dts": "^4.5.4",
    "@ww/core": "workspace:*"
  }
}
