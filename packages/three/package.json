{
  "name": "@webworld/three",
  "version": "0.1.0",
  "description": "Three.js 的強化層：換一個字就有螢幕誤差 LOD、空間分割剔除與世界串流。",
  "keywords": [
    "three",
    "threejs",
    "webgl",
    "webgpu",
    "lod",
    "culling",
    "instancing",
    "streaming",
    "open-world"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasYeh/WebWorldEngine.git",
    "directory": "packages/three"
  },
  "bugs": "https://github.com/thomasYeh/WebWorldEngine/issues",
  "homepage": "https://github.com/thomasYeh/WebWorldEngine/tree/main/packages/three#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node tools/flatten-types.mjs",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "peerDependencies": {
    "three": ">=0.185.0 <0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@ww/assets-runtime": "workspace:*",
    "@ww/core": "workspace:*",
    "@ww/engine": "workspace:*",
    "ktx-parse": "^1.1.0",
    "meshoptimizer": "^1.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@webworld/format": "workspace:*"
  }
}
