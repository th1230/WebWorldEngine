{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "internal/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tools/*/src/**/*.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
